# ---------------------------------------------------------------------------
# Unified LLM API (Anthropic-compatible)
#   Used for BOTH academic-value assessment AND Chinese recommendation reasons.
#   Default: MiniMax-M2.7 via Anthropic-compatible endpoint.
# ---------------------------------------------------------------------------
ACADEMIC_VALUE_URL=https://api.minimaxi.com/anthropic
ACADEMIC_VALUE_API_KEY=sk-...
ACADEMIC_VALUE_BACKUP_API_KEY=sk-...
ACADEMIC_VALUE_MODEL=MiniMax-M2.7

# ---------------------------------------------------------------------------
# OpenAlex email (optional, increases rate limit)
# ---------------------------------------------------------------------------
OPENALEX_EMAIL=your@email.com

# ---------------------------------------------------------------------------
# Data directory
# ---------------------------------------------------------------------------
PAPER_DAILY_DATA_DIR=./data

# ---------------------------------------------------------------------------
# Search & output tuning
# ---------------------------------------------------------------------------
PAPER_DAILY_TOP_N=10
PAPER_DAILY_MAX_RESULTS=50
PAPER_DAILY_DAYS_BACK=180

# Pre-ranking trim ratio: discard bottom N%% before academic assessment.
#   0.0 = assess all papers (no trim)
#   0.1 = trim bottom 10%%
#   0.2 = trim bottom 20%% (default)
PAPER_DAILY_TRIM_RATIO=0.20
# PAPER_DAILY_SOURCES="arxiv,semantic_scholar,openalex,crossref"
# PAPER_DAILY_RESOLVE_ARXIV=true

# Debug mode: print searched papers, LLM requests/responses, and filtering details
#   true = enable debug output
#   false = disable (default)
PAPER_DAILY_DEBUG=false

# ---------------------------------------------------------------------------
# Summarizer backend for arXiv papers (arxiv2md-summarize skill)
#   Available: claude | kimi-cli | hermes
#   Default: claude  (uses `claude -p <prompt>`)
#   kimi-cli  -> `kimi-cli -p <prompt>`
#   hermes    -> `hermes chat -q <prompt>`
# ---------------------------------------------------------------------------
# PAPER_DAILY_SUMMARIZER=claude

# ---------------------------------------------------------------------------
# Ranking weights (5-dimension, uniform by default)
# ---------------------------------------------------------------------------
W_RELEVANCE=0.20
W_RECENCY=0.20
W_IMPACT=0.20
W_NOVELTY=0.20
W_ACADEMIC_VALUE=0.20
